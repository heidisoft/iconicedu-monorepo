# ─── Database (Prisma) ────────────────────────────────────────────────────────
# Supabase Postgres connection string.
# Cloud: Supabase dashboard → Settings → Database → Connection string (URI, Transaction pooler)
# Local:  postgresql://postgres:postgres@localhost:54322/postgres
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

# Direct (non-pooled) URL for Prisma migrations
# Cloud: Supabase dashboard → Settings → Database → Connection string (URI, Session pooler)
# Local: same as DATABASE_URL for local
DIRECT_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres

# ─── Supabase ─────────────────────────────────────────────────────────────────
# From: Supabase dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Auth ─────────────────────────────────────────────────────────────────────
# From: Supabase dashboard → Settings → API → JWT Settings → JWT Secret
JWT_SECRET=your-jwt-secret

# Internal automation dispatcher auth token (Edge Function -> API)
INTERNAL_REMINDERS_TOKEN_API=replace-with-long-random-secret

# ─── PostHog (Server Observability) ───────────────────────────────────────────
# Use the same project key as NEXT_PUBLIC_POSTHOG_KEY in apps/web.
POSTHOG_KEY=phc_your_project_key
POSTHOG_HOST=https://us.i.posthog.com
