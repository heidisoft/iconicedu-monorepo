# ─── Database (Prisma) ────────────────────────────────────────────────────────
# Supabase Postgres connection string.
# Cloud: Supabase dashboard → Settings → Database → Connection string (URI, Transaction pooler)
# Local:  postgresql://postgres:postgres@localhost:54322/postgres
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

# Direct (non-pooled) URL for Prisma migrations
# Cloud: Supabase dashboard → Settings → Database → Connection string (URI, Session pooler)
# Local: same as DATABASE_URL for local
DIRECT_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres

# ─── Supabase ─────────────────────────────────────────────────────────────────
# From: Supabase dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# ─── Auth ─────────────────────────────────────────────────────────────────────
# From: Supabase dashboard → Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret

# Internal automation dispatcher auth tokens (Edge Function -> API)
INTERNAL_REMINDERS_TOKEN=replace-with-long-random-secret
INTERNAL_EVENTS_TOKEN=replace-with-long-random-secret
INTERNAL_ACTIVITY_FEED_TOKEN=replace-with-long-random-secret

# Expo Push API authentication for push dispatch from apps/api
EXPO_ACCESS_TOKEN=your-expo-access-token

# ─── Daily (Live Sessions) ─────────────────────────────────────────────────────
# From: Daily.co dashboard → Developers → API keys. Required for the
# channels/:channelId/live-sessions/join endpoint to create Daily rooms — without
# it, join requests for Daily-provider channels fail with "Daily is not configured".
DAILY_API_KEY=your-daily-api-key
# Optional — defaults to https://api.daily.co/v1
DAILY_REST_BASE_URL=https://api.daily.co/v1
# Optional — from Daily dashboard → Developers → Webhooks. Skips signature
# verification on incoming webhooks when unset (fine for local dev only).
DAILY_WEBHOOK_SECRET=your-daily-webhook-secret

# ─── PostHog (Server Observability) ───────────────────────────────────────────
POSTHOG_KEY=phc_rMBk7brtcoHvsweVGzeLtYaRv9P5Lc5r3EzjyBJnYRZs
POSTHOG_HOST=https://t.iconicedu.lk

# ─── AI assist (issue #264, Experimental — refine + suggested replies) ────────
# Each org now configures its own provider + API key from the admin
# "Organization Settings → AI-assisted messaging" page (org_ai_provider_settings
# table) — there is no global provider key anymore. AI assist returns 503 for
# any org that hasn't configured and enabled it.
#
# This key only encrypts/decrypts those per-org API keys at rest — generate
# with `openssl rand -base64 32`. Must match the same value used by apps/web
# (whichever app saves the key needs the same key to decrypt it later).
AI_PROVIDER_KEY_ENCRYPTION_KEY=generate-with-openssl-rand-base64-32

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
