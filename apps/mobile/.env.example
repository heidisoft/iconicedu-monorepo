# ─── Supabase ─────────────────────────────────────────────────────────────────
# From: Supabase dashboard → Settings → API
#
# EXPO_PUBLIC_ prefix is required — variables are inlined at build time by Expo.
# Read in app via Constants.expoConfig?.extra (not process.env).
#
# Local development note (EXPO_PUBLIC_APP_ENV=local):
#   Set EXPO_PUBLIC_SUPABASE_URL to http://127.0.0.1:54321.
#   The app automatically replaces 127.0.0.1 with the Metro bundler's IP at
#   runtime, so Android emulators and physical devices reach local Supabase
#   without any manual URL changes. Only change this URL for cloud projects.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key
# Legacy fallback accepted during migration.
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Environment: local | development | preview | production
# Use "local" for local Supabase dev (enables Metro-IP Supabase URL rewriting).
EXPO_PUBLIC_APP_ENV=development

# ─── Cloudflare Turnstile (Supabase Attack Protection) ────────────────────────
# Public site key from the Cloudflare dashboard → Turnstile → your widget.
# Optional: when unset the auth screens render no widget and send no captchaToken,
# which is correct while Supabase Attack Protection / CAPTCHA is disabled.
# Local + CI: use Cloudflare's always-pass dummy key below.
# The matching secret key goes into Supabase (config.toml / dashboard), never here.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Origin the widget page runs as (must be an allowed hostname on the Cloudflare
# widget). Defaults to https://app.iconicedu.com; override only if needed.
# EXPO_PUBLIC_TURNSTILE_WIDGET_ORIGIN=https://app.iconicedu.com

# ─── PostHog Analytics ────────────────────────────────────────────────────────
POSTHOG_KEY=phc_rMBk7brtcoHvsweVGzeLtYaRv9P5Lc5r3EzjyBJnYRZs
POSTHOG_HOST=https://t.iconicedu.lk

# Optional local fallback; PostHog remains the rollout source when available.
EXPO_PUBLIC_ENABLE_SESSION_COMPLETION_CAROUSEL=false

# ─── Web App ───────────────────────────────────────────────────────────────────
# Base URL of the web app — used to resolve relative meeting links in session cards.
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# Base URL of the NestJS API used for authenticated mobile mutations.
# For physical devices in local development, use your machine's LAN IP instead of localhost.
EXPO_PUBLIC_API_URL=http://localhost:3001
