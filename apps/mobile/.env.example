# ─── Supabase ─────────────────────────────────────────────────────────────────
# From: Supabase dashboard → Settings → API
#
# EXPO_PUBLIC_ prefix is required — variables are inlined at build time by Expo.
# Read in app via Constants.expoConfig?.extra (not process.env).

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Environment: development | preview | production
EXPO_PUBLIC_APP_ENV=development

# ─── PostHog Analytics ────────────────────────────────────────────────────────
EXPO_PUBLIC_POSTHOG_KEY=your-posthog-key
EXPO_PUBLIC_POSTHOG_HOST=https://your-posthog-host

# ─── Web App ───────────────────────────────────────────────────────────────────
# Base URL of the web app — used to resolve relative meeting links in session cards.
EXPO_PUBLIC_WEB_URL=http://localhost:3000
