# ─── Supabase ─────────────────────────────────────────────────────────────────
# From: Supabase dashboard → Settings → API
#
# EXPO_PUBLIC_ prefix is required — variables are inlined at build time by Expo.
# Read in app via Constants.expoConfig?.extra (not process.env).
#
# Local development note (EXPO_PUBLIC_APP_ENV=local):
#   Set EXPO_PUBLIC_SUPABASE_URL to http://127.0.0.1:54321.
#   The app automatically replaces 127.0.0.1 with the Metro bundler's IP at
#   runtime, so Android emulators and physical devices reach local Supabase
#   without any manual URL changes. Only change this URL for cloud projects.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key
# Legacy fallback accepted during migration.
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Environment: local | development | preview | production
# Use "local" for local Supabase dev (enables Metro-IP Supabase URL rewriting).
EXPO_PUBLIC_APP_ENV=development

# ─── PostHog Analytics ────────────────────────────────────────────────────────
POSTHOG_KEY=your-posthog-key
POSTHOG_HOST=https://t.iconicedu.lk

# ─── Web App ───────────────────────────────────────────────────────────────────
# Base URL of the web app — used to resolve relative meeting links in session cards.
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# Base URL of the NestJS API used for authenticated mobile mutations.
# For physical devices in local development, use your machine's LAN IP instead of localhost.
EXPO_PUBLIC_API_URL=http://localhost:3001
