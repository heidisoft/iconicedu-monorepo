# Generated from config/environment-contract.json
# Source file: apps/mobile/.env.example
# Update the contract, then run `pnpm env:generate`.

# Human-readable environment name shared across web, api, mobile, and CI.
# Owner: platform · Visibility: public
ICONIC_ENV_NAME=local

# Environment tier identifier for promotion policy and automation.
# Owner: platform · Visibility: public
ICONIC_ENV_TIER=local

# Git branch or PR identifier for preview deployments.
# Owner: platform · Visibility: public
ICONIC_PREVIEW_BRANCH=pr-123

# Stable preview deployment reference shared across services.
# Owner: platform · Visibility: public
ICONIC_PREVIEW_REF=preview-pr-123

# Hosted Supabase project or branch ref for the active environment.
# Owner: supabase · Visibility: public
SUPABASE_PROJECT_REF=abcdefgh

# Public Supabase URL inlined into Expo builds.
# Owner: supabase · Visibility: public
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Public Supabase anon key inlined into Expo builds.
# Owner: supabase · Visibility: public
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# Public PostHog project key inlined into Expo builds.
# Owner: posthog · Visibility: public
EXPO_PUBLIC_POSTHOG_KEY=phc_non_prod_key

# PostHog ingestion host for the Expo app.
# Owner: posthog · Visibility: public
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Expo Application Services project identifier for push and build coordination.
# Owner: expo · Visibility: public
EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000
