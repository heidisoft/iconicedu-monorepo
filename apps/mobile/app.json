{
  "expo": {
    "name": "IconicEdu Mobile",
    "slug": "iconicedu-mobile",
    "version": "0.1.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "scheme": "iconicedu",
    "platforms": ["ios", "android"],
    "updates": {
      "enabled": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.iconicedu.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.iconicedu.mobile"
    },
    "plugins": ["expo-router", "expo-secure-store"]
  }
}
