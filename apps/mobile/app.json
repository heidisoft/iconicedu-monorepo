{
  "expo": {
    "name": "IconicEdu Mobile",
    "slug": "iconicedu-mobile",
    "version": "0.1.0",
    "sdkVersion": "54.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "iconicedu",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "platforms": ["ios", "android"],
    "updates": {
      "enabled": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.iconicedu.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.iconicedu.mobile",
      "userInterfaceStyle": "automatic"
    },
    "plugins": ["react-native-edge-to-edge", "expo-router", "expo-secure-store", "expo-splash-screen"]
  }
}
