{
  "expo": {
    "name": "IconicEdu Mobile",
    "slug": "iconicedu-mobile",
    "version": "0.1.0",
    "sdkVersion": "55.0.0",
    "icon": "./assets/icon.png",
    "orientation": "default",
    "scheme": "iconicedu",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "platforms": ["ios", "android"],
    "updates": {
      "enabled": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.heidisoft.iconicedu"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.heidisoft.iconicedu",
      "userInterfaceStyle": "automatic",
      "resizeableActivity": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "react-native-edge-to-edge",
      "expo-router",
      "expo-secure-store",
      "expo-splash-screen",
      "expo-sharing",
      "expo-web-browser",
      "expo-audio",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0f172a"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "82adc837-03b9-4b58-93d5-93759e99417a"
      }
    },
    "owner": "iconic-academy"
  }
}
