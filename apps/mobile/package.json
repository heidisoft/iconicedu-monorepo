{
  "name": "mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "build": "pnpm run typecheck",
    "dev": "pnpm canvas:build && expo start --dev-client --clear",
    "dev:local": "pnpm canvas:build && bash scripts/dev-mobile.sh",
    "dev:ios": "pnpm canvas:build && expo run:ios",
    "dev:android": "pnpm canvas:build && expo run:android",
    "start": "pnpm canvas:build && expo start --dev-client --clear",
    "ios": "pnpm canvas:build && expo run:ios",
    "android": "pnpm canvas:build && expo run:android",
    "typecheck": "pnpm canvas:build && tsc -p tsconfig.json --noEmit",
    "lint": "eslint app src --ext .ts,.tsx",
    "lint:fix": "eslint app src --ext .ts,.tsx --fix",
    "test": "jest --passWithNoTests --watchman=false",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --passWithNoTests",
    "clean": "rm -rf .expo dist android ios",
    "native:prebuild": "expo prebuild",
    "native:prebuild:clean": "expo prebuild --clean",
    "eas:build:dev": "eas build --profile development --platform all",
    "eas:build:dev:ios": "eas build --profile development --platform ios",
    "eas:build:dev:android": "eas build --profile development --platform android",
    "eas:build:preview": "eas build --profile preview --platform all",
    "eas:build:prod": "eas build --profile production --platform all",
    "eas:build:ios": "eas build --profile production --platform ios",
    "eas:build:android": "eas build --profile production --platform android",
    "eas:submit": "eas submit --platform all",
    "eas:submit:ios": "eas submit --platform ios",
    "eas:submit:android": "eas submit --platform android",
    "eas:update": "pnpm canvas:build && eas update",
    "eas:update:production": "pnpm canvas:build && eas update --channel production",
    "eas:update:preview": "pnpm canvas:build && eas update --channel preview",
    "export:bundle": "pnpm canvas:build && EXPO_NO_TELEMETRY=1 npx expo export --platform android --output-dir .expo/dist",
    "canvas:build": "node scripts/build-classroom-canvas.mjs",
    "eas-build-post-install": "pnpm canvas:build",
    "test:e2e:classroom": "maestro test .maestro/classroom-ui.yaml .maestro/classroom-join-failure.yaml .maestro/classroom-moderation.yaml .maestro/classroom-student.yaml .maestro/classroom-link-entry.yaml .maestro/classroom-export.yaml .maestro/classroom-annotations.yaml",
    "test:e2e:classroom:live": "maestro test .maestro/classroom-live.yaml",
    "test:e2e:classroom:host": "maestro test .maestro/classroom-live-host.yaml"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.0",
    "@expo/metro-runtime": "^55.0.6",
    "@iconicedu/shared-types": "workspace:*",
    "@iconicedu/ui-native": "workspace:*",
    "@posthog/react-native-plugin": "^2.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/native-stack": "^7.14.4",
    "@supabase/supabase-js": "^2.86.0",
    "@tanstack/react-query": "^5.90.11",
    "@zoom/react-native-videosdk": "2.6.1",
    "expo": "^55.0.0",
    "expo-audio": "~55.0.8",
    "expo-camera": "~55.0.19",
    "expo-constants": "^55.0.7",
    "expo-document-picker": "^55.0.8",
    "expo-file-system": "~55.0.10",
    "expo-image-manipulator": "~55.0.15",
    "expo-image-picker": "^55.0.11",
    "expo-linking": "^55.0.7",
    "expo-location": "~55.1.10",
    "expo-navigation-bar": "^55.0.8",
    "expo-notifications": "~55.0.12",
    "expo-router": "^55.0.0",
    "expo-secure-store": "~55.0.8",
    "expo-sharing": "~55.0.11",
    "expo-splash-screen": "~55.0.10",
    "expo-status-bar": "~55.0.4",
    "expo-updates": "~55.0.21",
    "expo-web-browser": "~55.0.9",
    "nativewind": "^4.2.1",
    "posthog-react-native": "^4.53.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-native": "0.83.2",
    "react-native-blob-util": "^0.24.7",
    "react-native-edge-to-edge": "^1.8.1",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-pdf": "^7.0.4",
    "react-native-reanimated": "~4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "~15.15.3",
    "react-native-webview": "^13.16.1",
    "react-native-worklets": "0.7.2",
    "tailwindcss": "3",
    "@iconicedu/utils": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@testing-library/react-native": "^13.3.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "esbuild": "0.25.12",
    "expo-dev-client": "^55.0.22",
    "jest": "^29.7.0",
    "jest-expo": "^55.0.0",
    "react-test-renderer": "19.2.4",
    "typescript": "^5.9.3"
  }
}
