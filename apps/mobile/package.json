{
  "name": "mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "build": "pnpm run typecheck",
    "dev": "expo start --clear",
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint app src --ext .ts,.tsx",
    "lint:fix": "eslint app src --ext .ts,.tsx --fix",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --passWithNoTests",
    "clean": "rm -rf .expo dist android ios",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "eas:build:dev": "eas build --profile development --platform all",
    "eas:build:preview": "eas build --profile preview --platform all",
    "eas:build:prod": "eas build --profile production --platform all",
    "eas:build:ios": "eas build --profile production --platform ios",
    "eas:build:android": "eas build --profile production --platform android",
    "eas:submit": "eas submit --platform all",
    "eas:submit:ios": "eas submit --platform ios",
    "eas:submit:android": "eas submit --platform android",
    "eas:update": "eas update"
  },
  "dependencies": {
    "@iconicedu/shared-types": "workspace:*",
    "@iconicedu/ui-native": "workspace:*",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.8.1",
    "@supabase/supabase-js": "^2.86.0",
    "@tanstack/react-query": "^5.90.11",
    "@expo/metro-runtime": "^6.1.2",
    "expo": "^54.0.25",
    "expo-constants": "^18.0.13",
    "expo-linking": "^8.0.11",
    "expo-router": "~6.0.15",
    "expo-secure-store": "~15.0.7",
    "expo-splash-screen": "~31.0.11",
    "expo-status-bar": "~3.0.8",
    "nativewind": "^4.2.1",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "~15.12.1",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "3"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@testing-library/react-native": "^13.3.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.17",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.9.3"
  }
}
