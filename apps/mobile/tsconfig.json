{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@iconicedu/mobile/*": ["./*"],
      "@iconicedu/mobile": ["."],
      "@iconicedu/ui-native/*": ["../../packages/ui-native/src/*"],
      "@iconicedu/ui-native": ["../../packages/ui-native/src"],
      "@iconicedu/shared-types/*": ["../../packages/shared-types/src/*"],
      "@iconicedu/shared-types": ["../../packages/shared-types/src"],
      "@iconicedu/utils/*": ["../../packages/utils/src/*"],
      "@iconicedu/utils": ["../../packages/utils/src"]
    }
  },
  "include": ["app/**/*", "src/**/*", "*.ts", "*.tsx", "nativewind-env.d.ts"],
  "exclude": ["node_modules", "**/__tests__/**", "**/*.test.ts", "**/*.test.tsx"]
}
