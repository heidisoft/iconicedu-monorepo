# ─── Supabase ─────────────────────────────────────────────────────────────────
# From: Supabase dashboard → Settings → API

# Project URL (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/public key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — NEVER expose to the browser, server-only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Internal automation/authenticated route secrets
INTERNAL_REMINDERS_TOKEN=replace-with-long-random-secret
INTERNAL_ACTIVITY_FEED_TOKEN=replace-with-long-random-secret

# ─── PostHog Analytics ────────────────────────────────────────────────────────
