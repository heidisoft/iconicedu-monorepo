# ─── Supabase ─────────────────────────────────────────────────────────────────
# In production/preview, these are injected by the Vercel+Supabase connector.
# For local dev, set them manually here.

# Project URL — must be NEXT_PUBLIC_ so the browser bundle can access it.
# (The connector sets SUPABASE_URL server-side; this is still required for client-side.)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/publishable key — connector name is NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
# NEXT_PUBLIC_SUPABASE_ANON_KEY is accepted as a fallback.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Service role key — NEVER expose to the browser, server-only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google reCAPTCHA v2 site key. Enable the `enable-web-recaptcha` feature flag
# only after this key and the matching Supabase Auth CAPTCHA secret are configured.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-v2-site-key

# Internal automation/authenticated route secrets
INTERNAL_REMINDERS_TOKEN=replace-with-long-random-secret
INTERNAL_EVENTS_TOKEN=replace-with-long-random-secret
INTERNAL_ACTIVITY_FEED_TOKEN=replace-with-long-random-secret

# ─── PostHog Analytics ────────────────────────────────────────────────────────
POSTHOG_KEY=phc_rMBk7brtcoHvsweVGzeLtYaRv9P5Lc5r3EzjyBJnYRZs
POSTHOG_HOST=https://t.iconicedu.lk
