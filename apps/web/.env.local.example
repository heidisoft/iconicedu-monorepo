# Generated from config/environment-contract.json
# Source file: apps/web/.env.local.example
# Update the contract, then run `pnpm env:generate`.

# Human-readable environment name shared across web, api, mobile, and CI.
# Owner: platform · Visibility: public
ICONIC_ENV_NAME=local

# Environment tier identifier for promotion policy and automation.
# Owner: platform · Visibility: public
ICONIC_ENV_TIER=local

# Git branch or PR identifier for preview deployments.
# Owner: platform · Visibility: public
ICONIC_PREVIEW_BRANCH=pr-123

# Stable preview deployment reference shared across services.
# Owner: platform · Visibility: public
ICONIC_PREVIEW_REF=preview-pr-123

# Hosted Supabase project or branch ref for the active environment.
# Owner: supabase · Visibility: public
SUPABASE_PROJECT_REF=abcdefgh

# Browser-safe Supabase project URL for the web app.
# Owner: supabase · Visibility: public
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Preferred publishable Supabase key for the web app.
# Owner: supabase · Visibility: public
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-local-publishable-key

# Legacy anon Supabase key fallback for the web app.
# Owner: supabase · Visibility: public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# Server-only Supabase service role key used by web, api, and edge jobs.
# Owner: supabase · Visibility: secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Web or edge-function token for internal reminders dispatch endpoints.
# Owner: platform · Visibility: secret
INTERNAL_REMINDERS_TOKEN=replace-with-long-random-secret

# Internal token for notifications dispatch endpoints.
# Owner: platform · Visibility: secret
INTERNAL_NOTIFICATIONS_TOKEN=replace-with-long-random-secret

# Internal token for activity-feed projection endpoints.
# Owner: platform · Visibility: secret
INTERNAL_ACTIVITY_FEED_TOKEN=replace-with-long-random-secret

# Browser-safe PostHog project key for the web app.
# Owner: posthog · Visibility: public
NEXT_PUBLIC_POSTHOG_KEY=phc_non_prod_key

# PostHog ingestion host for the web app.
# Owner: posthog · Visibility: public
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Server-side PostHog project key for API analytics and web flag evaluation.
# Owner: posthog · Visibility: secret
POSTHOG_KEY=phc_non_prod_key

# Server-side PostHog host for API analytics and flag evaluation.
# Owner: posthog · Visibility: secret
POSTHOG_HOST=https://us.i.posthog.com

# Daily REST API key for hosted live-session room creation.
# Owner: daily · Visibility: secret
DAILY_API_KEY=daily_sandbox_key

# Optional Daily API base URL override.
# Owner: daily · Visibility: public
DAILY_REST_BASE_URL=https://api.daily.co/v1

# Daily webhook signing secret.
# Owner: daily · Visibility: secret
DAILY_WEBHOOK_SECRET=daily_webhook_secret
