    "@iconicedu/utils": "workspace:*",
    "@supabase/ssr": "^0.5.0",
    "@supabase/supabase-js": "^2.86.0",
    "@tanstack/react-query": "^5.90.11",
    "@vercel/analytics": "1.3.1",
    "@vercel/speed-insights": "^1.0.12",
    "flags": "^4.0.3",
    "jotai": "^2.18.0",
    "next": "^15.2.0",
    "posthog-js": "^1.359.1",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^15.2.0",
    "typescript": "^5.9.3"
  }
