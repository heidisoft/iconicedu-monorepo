      "ICONIC_PREVIEW_BRANCH",
      "ICONIC_PREVIEW_REF",
      "SUPABASE_PROJECT_REF",
      "EXPO_PUBLIC_SUPABASE_URL",
      "EXPO_PUBLIC_SUPABASE_ANON_KEY",
      "EXPO_PUBLIC_POSTHOG_KEY",
      "EXPO_PUBLIC_POSTHOG_HOST",
      "EAS_PROJECT_ID"
    ],
    "apps/api/.env.example": [
      "ICONIC_ENV_NAME",
      "ICONIC_ENV_TIER",
      "ICONIC_PREVIEW_BRANCH",
      "ICONIC_PREVIEW_REF",
      "SUPABASE_PROJECT_REF",
      "DATABASE_URL",
      "DIRECT_URL",
      "SEED_DATABASE_URL",
      "SUPABASE_URL",
      "SUPABASE_SERVICE_ROLE_KEY",
      "JWT_SECRET",
      "SUPABASE_JWT_SECRET",
      "INTERNAL_REMINDERS_TOKEN_API",
      "POSTHOG_KEY",
      "POSTHOG_HOST"
    ]
  },
  "targets": {
    "local-web": {
      "required": [
        "ICONIC_ENV_NAME",
        "ICONIC_ENV_TIER",
        "NEXT_PUBLIC_SUPABASE_URL",
        "SUPABASE_SERVICE_ROLE_KEY",
        "INTERNAL_REMINDERS_TOKEN",
        "INTERNAL_NOTIFICATIONS_TOKEN",
        "INTERNAL_ACTIVITY_FEED_TOKEN"
      ],
      "anyOf": [
        ["NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY"],
        ["NEXT_PUBLIC_SUPABASE_ANON_KEY"]
      ]
    },
    "local-api": {
      "required": [
        "ICONIC_ENV_NAME",
        "ICONIC_ENV_TIER",
        "DATABASE_URL",
        "DIRECT_URL",
        "SUPABASE_URL",
        "SUPABASE_SERVICE_ROLE_KEY",
        "JWT_SECRET"
      ]
    },
    "local-mobile": {
      "required": [
        "ICONIC_ENV_NAME",
