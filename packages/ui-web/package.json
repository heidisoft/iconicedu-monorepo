{
  "name": "@iconicedu/ui-web",
  "version": "0.1.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/ui-web.css"
  },
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../node_modules/@tailwindcss/cli/dist/index.mjs -i ./src/styles/global.css -o ./dist/ui-web.css --minify",
    "dev": "tsc -p tsconfig.json --watch & pnpm run tailwind:watch",
    "start": "pnpm run dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "test": "vitest run src",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "tailwind:build": "node ../../node_modules/@tailwindcss/cli/dist/index.mjs -i ./src/styles/global.css -o ./dist/ui-web.css",
    "tailwind:watch": "node ./scripts/watch-tailwind.js",
    "clean": "rm -rf dist",
    "shadcn:add": "pnpm dlx shadcn@latest add"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@iconicedu/shared-types": "workspace:*",
    "@tailwindcss/postcss": "^4.1.9",
    "@types/node": "^22",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^3.2.4",
